#!/usr/bin/env python3
"""Servo motion test for a Raspberry Pi using gpiozero.

This script moves a servo to a few angles so you can observe
its movement speed and check whether it can move a flap.
"""

import time

try:
    from gpiozero import Servo
except ImportError:
    print("gpiozero is not available. This script is intended for a Raspberry Pi.")
    raise


SERVO_PIN = 18
MIN_PULSE_WIDTH = 0.0005
MAX_PULSE_WIDTH = 0.0025


def angle_to_value(angle_degrees):
    """Convert 0..180 degrees to gpiozero's -1..1 range."""
    return (angle_degrees / 90.0) - 1


def set_angle(servo_obj, angle_degrees, pause_seconds=0.2):
    if not 0 <= angle_degrees <= 180:
        raise ValueError("angle must be between 0 and 180")

    servo_obj.value = angle_to_value(angle_degrees)
    print(f"Moving to {angle_degrees}°")
    time.sleep(pause_seconds)


def run_test(angles=(0, 90, 180), pause_seconds=0.5):
    servo = Servo(SERVO_PIN, min_pulse_width=MIN_PULSE_WIDTH, max_pulse_width=MAX_PULSE_WIDTH)

    try:
        for angle in angles:
            set_angle(servo, angle, pause_seconds=pause_seconds)
    except KeyboardInterrupt:
        print("\nStopping servo test")
    finally:
        servo.value = angle_to_value(0)
        servo.detach()


if __name__ == "__main__":
    run_test()
